-- // SERVICES
local Players      = game:GetService("Players")
local RS           = game:GetService("ReplicatedStorage")
local RunService   = game:GetService("RunService")
local HTTP         = game:GetService("HttpService")
local UIS          = game:GetService("UserInputService")
local player       = Players.LocalPlayer

-- // FILE SYSTEM SETUP
local FILE_NAME = "TempoHub_AutoSave.json"
local function saveSettings(data)
    writefile(FILE_NAME, HTTP:JSONEncode(data))
end

local function loadSettings()
    if isfile(FILE_NAME) then
        local success, decoded = pcall(function() return HTTP:JSONDecode(readfile(FILE_NAME)) end)
        if success then return decoded end
    end
    return nil
end

-- // LOAD DEFAULTS OR SAVED DATA
local savedData = loadSettings() or {}

-- // FEATURES & STATES
local Features = {
    Ice         = { label = "Collect Ice",    remote = "CollectIce",    args = { "Normal",      Vector3.new(3.1364, 11.5126, 10784.038) } },
    Bubble      = { label = "Collect Bubble", remote = "CollectBubble", args = { "Dark Matter", Vector3.new(-18.6984, 8.3374, 10582.273) } },
    FishClick   = { label = "Fish Click",     remote = "FishClick",     args = {} },
    BubblesRune = { label = "Rune: Bubbles",  remote = "RuneOpen",      args = { "Bubbles" } },
    Water       = { label = "Rune: Water",    remote = "RuneOpen",      args = { "Water" } },
    Depth       = { label = "Rune: Depth",    remote = "RuneOpen",      args = { "Depth" } },
    IceRune     = { label = "Rune: Ice",      remote = "RuneOpen",      args = { "Ice" } },
    FishRune    = { label = "Rune: Fish",     remote = "RuneOpen",      args = { "Fish" } },
}

local states = savedData.states or {}
for k in pairs(Features) do if states[k] == nil then states[k] = false end end

local bulk  = savedData.bulk or { count = 1, speed = 0.001 }
local mods  = savedData.mods or { speed = 16, jump = 50, noclip = false }

-- // SYNC FUNCTION
local function sync()
    saveSettings({states = states, bulk = bulk, mods = mods})
end

-- // LOAD WINDUI
local WindUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))()

-- // REMOTES
local function getRemote(n)
    for _, v in ipairs(RS:GetDescendants()) do
        if v:IsA("RemoteEvent") and v.Name == n then return v end
    end
end
local Remotes = {
    RuneOpen      = getRemote("RuneOpen"),
    CollectIce    = getRemote("CollectIce"),
    CollectBubble = getRemote("CollectBubble"),
    FishClick     = getRemote("FishClick"),
}

