-- // FILE SYSTEM SETUP
local FILE_NAME = "TempoHub_AutoSave.json"
local function saveSettings(data)
    if writefile then writefile(FILE_NAME, HTTP:JSONEncode(data)) end
end

local function loadSettings()
    if isfile and isfile(FILE_NAME) then
        local success, decoded = pcall(function() return HTTP:JSONDecode(readfile(FILE_NAME)) end)
        if success then return decoded end
    end
    return nil
end

-- // LOAD DEFAULTS OR SAVED DATA
