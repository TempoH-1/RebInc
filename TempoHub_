-- ==========================
-- CORE LOOP
-- ==========================
local timers = {}
for k in pairs(Features) do timers[k] = 0 end

RunService.Heartbeat:Connect(function(dt)
    if mods.noclip and player.Character then
        for _, p in ipairs(player.Character:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end
    for key, data in pairs(Features) do
        if states[key] then
            timers[key] = timers[key] + dt
            if timers[key] >= (bulk.speed or 0.001) then
                timers[key] = 0
                local r = Remotes[data.remote]
                if r then
                    local count = (key == "Ice" or key == "Bubble") and bulk.count or 1
                    for _ = 1, count do r:FireServer(unpack(data.args)) end
                end
            end
        end
    end
end)

applyMods()
