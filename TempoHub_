-- // CORE LOOPS
local timers = { fast = 0, slow = 0 }
RunService.Heartbeat:Connect(function(dt)
    if mods.noclip and player.Character then
        for _, p in ipairs(player.Character:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end
    end

    -- HIGH SPEED (Runes + Farming)
    timers.fast = timers.fast + dt
    if timers.fast >= (bulk.speed or 0.001) then
        timers.fast = 0
        -- Farming
        if states.Ice and Remotes.CollectIce then for _=1, bulk.count do Remotes.CollectIce:FireServer("Normal", Vector3.new(3.1364, 11.5126, 10784.038)) end end
        if states.Bubble and Remotes.CollectBubble then for _=1, bulk.count do Remotes.CollectBubble:FireServer("Dark Matter", Vector3.new(-18.6984, 8.3374, 10582.273)) end end
        if states.FishClick and Remotes.FishClick then for _=1, bulk.count do Remotes.FishClick:FireServer() end end
        -- Runes
        for _, r in ipairs(RuneList) do
            if states["Rune_"..r.name] and Remotes.RuneOpen then
                for _=1, bulk.count do Remotes.RuneOpen:FireServer(r.name) end
            end
        end
    end

    -- SLOW LOOP (Upgrades)
    timers.slow = timers.slow + dt
    if timers.slow >= 0.25 then
        timers.slow = 0
        for _, u in ipairs(W1_Upgrades) do if states["W1_"..u.cat.."_"..u.id] then Remotes.Upgrade:FireServer(u.cat, u.id, false) end end
        for _, u in ipairs(W2_Upgrades) do if states["W2_"..u.cat.."_"..u.id] then Remotes.Upgrade:FireServer(u.cat, u.id, false) end end
        if states.AutoTier then Remotes.TierUp:FireServer() end
        if states.AutoReborn then Remotes.Reborn:FireServer("RebornHitbox1") end
    end
end)

applyMods()
