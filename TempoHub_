    Upgrade        = GP:WaitForChild("Upgrade"),
    VoltageUpgrade = GP:WaitForChild("VoltageUpgrade"),
    TierUp         = GP:WaitForChild("TierUp"),
    Reborn         = GP:WaitForChild("Reborn"),
    RuneOpen       = GP:WaitForChild("RuneOpen"),
}

-- Resolve Farming Remotes
for _, v in ipairs(RS:GetDescendants()) do
    if v:IsA("RemoteEvent") then
        if v.Name == "CollectIce" then Remotes.CollectIce = v
        elseif v.Name == "CollectBubble" then Remotes.CollectBubble = v
        elseif v.Name == "FishClick" then Remotes.FishClick = v end
    end
end

