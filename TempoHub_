-- MISC / PLAYER
-- ==========================
local function applyMods()
    local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if hum then 
        hum.WalkSpeed = mods.speed 
        hum.JumpPower = mods.jump 
        hum.UseJumpPower = true 
    end
end

local PlayerSec = MiscTab:Section({ Title = "Modifications" })
PlayerSec:Slider({ 
    Title = "WalkSpeed", 
    Value = {Min=16, Max=500, Default = mods.speed}, 
    Callback = function(v) mods.speed = v; applyMods(); sync() end 
})
PlayerSec:Slider({ 
    Title = "JumpPower", 
    Value = {Min=50, Max=500, Default = mods.jump}, 
    Callback = function(v) mods.jump = v; applyMods(); sync() end 
})
PlayerSec:Toggle({ 
    Title = "Noclip", 
    Value = mods.noclip, 
    Callback = function(v) mods.noclip = v; sync() end 
})

